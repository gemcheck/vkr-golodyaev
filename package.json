{
  "name": "vkr-golodyaev",
  "displayName": "vkr-golodyaev",
  "description": "Минимальное расширение для Python подсветки",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:python"
  ],
  "contributes": {
    "languages": [
      {
        "id": "python",
        "extensions": [".py"]
      }
    ],  
    "semanticTokenTypes": [
      { "id": "function", "description": "Custom function token" },
      { "id": "variable", "description": "Custom variable token" },
      { "id": "parameter", "description": "Custom parameter token" },
      { "id": "keyword", "description": "Custom keyword token" },
      { "id": "string", "description": "String literals" },
      { "id": "number", "description": "Numeric literals" },
      { "id": "boolean", "description": "Boolean literals" }
    ],
    "themes": [
        {
            "label": "VKR Python Colors",
            "uiTheme": "vs-dark",
            "path": "./themes/vkr-python-color-theme.json"
        }
    ],
    "commands": [
      {
        "command": "vkr-golodyaev.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "vkr-golodyaev.currentFile",
        "title": "Show Current File"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.110.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
